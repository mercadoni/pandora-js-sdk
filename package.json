{
  "name": "@instaleap/pandora-js-sdk",
  "version": "2.3.0",
  "description": "TypeScript SDK for ecommerce platform integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/instaleap/pandora-js-sdk.git"
  },
  "homepage": "https://github.com/instaleap/pandora-js-sdk#readme",
  "keywords": [
    "ecommerce",
    "sdk",
    "graphql",
    "typescript",
    "cart",
    "auth"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "ts-node src/test/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsc -w"
  },
  "dependencies": {
    "isomorphic-unfetch": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.24.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
